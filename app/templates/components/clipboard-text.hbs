<div class="clipboard-text"
  {{did-insert this.setupEventHandlers}}
  {{will-destroy this.remoeEventHandlers}}
>
<span>
{{#if (has-block)}}
  {{ yield }}
{{else}}
  {{ this.args.text }}
{{/if}}
</span>
{{#if this.copyButtonIsVisible}}
  <ClipboardButton @copyText={{this.args.text}}/>
{{else}}
  <div class="clipboard-button-placeholder"></div>
{{/if}}
</div>